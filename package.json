{
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/api",
    "packages/auth",
    "packages/common",
    "packages/auth-client",
    "packages/policy",
    "packages/broker",
    "packages/deploy"
  ],
  "scripts": {
    "emulator": "npx firebase emulators:start",
    "auth": "npm run -w packages/auth dev",
    "api": "npm run -w packages/api dev",
    "lint": "eslint test/ scripts/",
    "lint:fix": "eslint --fix test/ scripts/",
    "test": "NODE_OPTIONS=--experimental-vm-modules firebase emulators:exec jest",
    "test:unit": "node scripts/run-jest-targets.js unit",
    "test:emulated": "node scripts/run-jest-targets.js emulated",
    "test:ci:emulated": "firebase emulators:exec --only auth,firestore \"npm run test:emulated\"",
    "gcp:api:build": "npm run deploy -- api",
    "gcp:api:deploy": "npm run deploy -- api",
    "gcp:api:logs": "gcloud run logs read api --region us-central1",
    "gcp:auth:build": "npm run deploy -- auth",
    "gcp:auth:deploy": "npm run deploy -- auth",
    "gcp:auth:logs": "gcloud run logs read auth --region us-central1",
    "gcp:broker:deploy": "npm run deploy -- broker",
    "gcp:broker:logs": "gcloud run logs read broker --region us-central1",
    "gcp:policy:deploy": "npm run deploy -- policy",
    "gcp:policy:logs": "gcloud run logs read policy --region us-central1",
    "deploy": "node packages/deploy/src/cli.js",
    "rollback": "node packages/deploy/src/cli.js rollback",
    "test:deploy": "npm test -w @graffiticode/deploy",
    "gcp:broker:build": "npm run deploy -- broker",
    "gcp:policy:build": "npm run deploy -- policy",
    "upgrade-l0000-and-deploy": "node scripts/upgrade-l0000-and-deploy.js",
    "upgrade-l0000-view-and-deploy": "node scripts/upgrade-l0000-view-and-deploy.js"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.0",
    "eslint": "^8.44.0",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.27.5",
    "eslint-plugin-n": "^16.0.1",
    "eslint-plugin-promise": "^6.1.1",
    "firebase": "^10.0.0",
    "firebase-tools": "^12.4.3",
    "jest": "^29.6.1",
    "@graffiticode/deploy": "0.1.0"
  },
  "jest": {
    "testPathIgnorePatterns": [
      "<rootDir>/packages/",
      "<rootDir>/languages/",
      "<rootDir>/node_modules/"
    ]
  },
  "dependencies": {
    "@graffiticode/parser": "^1.4.0"
  }
}
