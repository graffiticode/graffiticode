# ISOLATE-01 step 3: the AT-11 probe image (scripts/at11/Dockerfile's contents) with step 3's
# production probe configs baked in at /config.
#   gcloud builds submit --project=graffiticode --config deploy/egress-proxy/step3/probe.cloudbuild.yaml (from the repo root)
FROM node:22.23.3@sha256:363e1587494626837fa7f9a23bdb453d13b0ff3c67c705c2805cfc69c2d2fad7
WORKDIR /probe
COPY scripts/at11/lib.js scripts/at11/net.js scripts/at11/iam.js scripts/at11/
COPY deploy/egress-proxy/step3/at11/ /config/
USER node
ENTRYPOINT ["node"]
