# ISOLATE-01 step 7: the AT-11 probe image (scripts/at11's probes) with step 7's production
# configs baked in at /config: one per network class, and the IAM probe's (compilers and the
# control). Every job of a run uses this one image, by digest.
#   built from a context of only the files it copies (scripts/at11/step7-jobs.js prints the commands);
#   the repo root would upload every node_modules and Rust target
FROM node:22.23.3@sha256:363e1587494626837fa7f9a23bdb453d13b0ff3c67c705c2805cfc69c2d2fad7
WORKDIR /probe
COPY scripts/at11/lib.js scripts/at11/net.js scripts/at11/iam.js scripts/at11/
COPY deploy/egress-proxy/step7/at11/ /config/
USER node
ENTRYPOINT ["node"]
