# ISOLATE-01 step 0: the AT-11 probe image (scripts/at11/Dockerfile's contents) with step 0's
# probe configs baked in at /config. One image, one digest, for every step 0 job.
#   gcloud builds submit --config deploy/egress-proxy/step0/probe.cloudbuild.yaml (from the repo root)
FROM node:22.23.3@sha256:363e1587494626837fa7f9a23bdb453d13b0ff3c67c705c2805cfc69c2d2fad7
WORKDIR /probe
COPY scripts/at11/lib.js scripts/at11/net.js scripts/at11/iam.js scripts/at11/
COPY deploy/egress-proxy/step0/at11/ /config/
USER node
ENTRYPOINT ["node"]
