# ISOLATE-01 step 0: the Node and Rust egress helpers in one image, run as each compiler class
# behind the proxy. Context: a staging directory with languages/l0000's Cargo workspace,
# packages/core/dist/egress.js and runtime.mjs (deploy/egress-proxy/step0/runtime.cloudbuild.yaml).
FROM rust:1.99-bookworm AS build
WORKDIR /src
COPY Cargo.toml Cargo.lock rustfmt.toml ./
COPY crates ./crates
RUN cargo build --release --locked -p graffiticode-l0000 --example egress_probe

FROM node:22.23.3@sha256:363e1587494626837fa7f9a23bdb453d13b0ff3c67c705c2805cfc69c2d2fad7
WORKDIR /rt
RUN npm install --no-save --no-audit --no-fund undici@7.30.0
COPY egress.js runtime.mjs ./
COPY --from=build /src/target/release/examples/egress_probe /rt/egress_probe
USER node
