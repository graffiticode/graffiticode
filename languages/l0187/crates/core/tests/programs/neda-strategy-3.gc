board [
  page [
    section [
      sticky id "objectivo-central" text "Objectivo central proposto: promover IA responsável que beneficie as pessoas, proteja os direitos e apoie o desenvolvimento sustentável, começando no Sumbe, Angola." fill "blue" {}
      sticky id "estado-neda" text "Estado institucional: a NEDA é apresentada como uma iniciativa independente de interesse público em proposta. Não é apresentada como instituição legalmente registada, aprovada ou endossada." fill "gray" {}
      group [
        shape id "missao-neda" text "Missão NEDA" kind ROUNDED_RECTANGLE fill "blue" {}
        shape id "piloto-inicial" text "Piloto administrativo" kind ROUNDED_RECTANGLE fill "yellow" {}
        shape id "porta-autorizacao" text "Autorizações escritas?" kind DIAMOND fill "orange" {}
        shape id "porta-evidencia" text "Evidência e aprovação?" kind DIAMOND fill "orange" {}
        shape id "decisao-escala" text "Escalar?" kind DIAMOND fill "green" {}
      ] id "fluxo-decisao" layout FLOW direction RIGHT {}
    ] id "missao-decisao" name "Missão, estado e decisão" layout COLUMN fill "#eef4ff" {}
    section [
      sticky id "piloto-inclui" text "Recomendação inicial: apoio à marcação administrativa e à gestão de filas numa única unidade de saúde. Inclui registo de marcações, estado da fila, lembretes apenas com consentimento e canal disponível, e relatórios operacionais simples." fill "green" {}
      sticky id "controlo-humano" text "A equipa humana mantém todas as decisões e pode corrigir, suspender ou substituir o processo." fill "blue" {}
      sticky id "piloto-exclui" text "Fora do âmbito: diagnóstico, triagem de urgência clínica, prescrições, priorização de doentes por IA e decisões clínicas autónomas." fill "pink" {}
    ] id "ambito-piloto" name "Piloto proposto: âmbito e limites" layout COLUMN fill "#f1f8f4" {}
    section [
      sticky id "dependencia-autorizacao" text "Não iniciar sem autorização escrita da unidade de saúde e das autoridades de saúde relevantes." fill "orange" {}
      sticky id "dependencia-processo" text "Antes do protótipo: avaliar o fluxo de trabalho actual, responsabilidades, necessidades dos utilizadores e sistemas já existentes." fill "yellow" {}
      sticky id "dependencia-dhis2" text "Assegurar compatibilidade com o ecossistema nacional de informação sanitária DHIS2 de Angola. Integrar com o que existe, em vez de criar um sistema paralelo." fill "blue" {}
    ] id "dependencias" name "Dependências críticas" layout COLUMN fill "#fff7e8" {}
    section [
      shape id "etapa-consulta" text "1. Consulta e medição inicial" kind ROUNDED_RECTANGLE fill "blue" {}
      shape id "etapa-mapeamento" text "2. Mapear o processo" kind ROUNDED_RECTANGLE fill "blue" {}
      shape id "etapa-revisao" text "3. Revisão legal e de segurança" kind ROUNDED_RECTANGLE fill "orange" {}
      shape id "etapa-prototipo" text "4. Protótipo mínimo" kind ROUNDED_RECTANGLE fill "yellow" {}
      shape id "etapa-formacao" text "5. Formação da equipa" kind ROUNDED_RECTANGLE fill "yellow" {}
      shape id "etapa-piloto" text "6. Piloto limitado" kind ROUNDED_RECTANGLE fill "green" {}
      shape id "etapa-avaliacao" text "7. Avaliação independente" kind ROUNDED_RECTANGLE fill "purple" {}
      shape id "etapa-escala" text "8. Escala condicionada" kind ROUNDED_RECTANGLE fill "green" {}
    ] id "etapas" name "Etapas de implementação propostas" layout GRID columns 2 fill "#f5f5f5" {}
    section [
      sticky id "indicadores-acesso" text "Acesso e serviço: tempo de espera e faltas às marcações." fill "blue" {}
      sticky id "indicadores-operacao" text "Operação: erros de registo, tempo da equipa dedicado à administração e disponibilidade do sistema." fill "yellow" {}
      sticky id "indicadores-confianca" text "Confiança e protecção: satisfação dos utilizadores, reclamações e incidentes de privacidade ou segurança." fill "purple" {}
      sticky id "indicadores-metodo" text "Medir antes e depois do piloto. Definir método, fonte e responsabilidade antes da recolha; não preencher metas sem linha de base e acordo institucional." fill "gray" {}
    ] id "indicadores" name "Indicadores de sucesso a medir" layout COLUMN fill "#eef4ff" {}
    section [
      sticky id "risco-acesso" text "Sem acesso institucional — não iniciar." fill "pink" {}
      sticky id "risco-dados" text "Exposição de dados de saúde — minimizar dados, aplicar acesso por função, encriptação, limites de retenção, plano de incidentes e revisão legal." fill "pink" {}
      sticky id "risco-conectividade" text "Conectividade instável — manter alternativa offline ou de baixa largura de banda." fill "orange" {}
      sticky id "risco-equipa" text "Resistência da equipa — co-desenho, comunicação e formação." fill "yellow" {}
      sticky id "risco-duplicacao" text "Sistemas duplicados — integrar ou interromper o projecto." fill "orange" {}
      sticky id "risco-exclusao" text "Exclusão de pessoas sem telefone — manter atendimento presencial e opção em papel." fill "yellow" {}
      sticky id "risco-fornecedor" text "Dependência de fornecedor e crescimento de custos — normas abertas, portabilidade e plano de saída." fill "purple" {}
      sticky id "risco-ia" text "Erros de IA — manter a IA fora das decisões clínicas." fill "pink" {}
    ] id "riscos" name "Riscos principais e mitigação" layout GRID columns 2 fill "#fff0f2" {}
    section [
      sticky id "viabilidade-valor" text "Demonstrar valor público credível e alinhamento com políticas aplicáveis." fill "blue" {}
      sticky id "viabilidade-originalidade" text "Demonstrar a originalidade face a iniciativas existentes, sem presumir novidade." fill "blue" {}
      sticky id "viabilidade-fases" text "Manter âmbito faseado e governação multidisciplinar." fill "green" {}
      sticky id "viabilidade-financiamento" text "Assegurar financiamento transparente e auditoria independente." fill "green" {}
      sticky id "viabilidade-resultados" text "Definir resultados mensuráveis e publicar limitações e aprendizagem." fill "yellow" {}
      sticky id "viabilidade-alegacoes" text "Não alegar parceria com UNESCO, União Africana ou MINSA até existir acordo formal." fill "orange" {}
    ] id "viabilidade" name "Condições gerais de viabilidade da NEDA" layout GRID columns 2 fill "#f1f8f4" {}
    section [
      sticky id "dominios-futuros" text "Fases posteriores, sujeitas a evidência, capacidade e aprovação: educação, conectividade, agricultura, ambiente, serviços públicos e telecomunicações. Não lançar estes domínios em simultâneo com o primeiro piloto." fill "purple" {}
    ] id "fases-futuras" name "Outros domínios: fases posteriores" layout COLUMN fill "#f7f0ff" {}
    section [
      sticky id "salvaguardas-humanas" text "Supervisão humana, respeito pelos direitos e acessibilidade." fill "blue" {}
      sticky id "salvaguardas-responsabilidade" text "Transparência, responsabilização e participação comunitária." fill "green" {}
      sticky id "salvaguardas-dados" text "Protecção de dados e cibersegurança desde a concepção." fill "orange" {}
    ] id "salvaguardas" name "Salvaguardas de governação" layout COLUMN fill "#eef4ff" {}
    connector id "ligacao-missao-piloto" from "missao-neda" to "piloto-inicial" label "primeira aplicação proposta" stroke "blue" stroke-width THICK {}
    connector id "ligacao-piloto-autorizacao" from "piloto-inicial" to "porta-autorizacao" label "depende de" stroke "orange" stroke-width THICK {}
    connector id "ligacao-autorizacao-evidencia" from "porta-autorizacao" to "porta-evidencia" label "pilotar e medir" stroke "orange" stroke-width THICK {}
    connector id "ligacao-evidencia-decisao" from "porta-evidencia" to "decisao-escala" label "decisão medida" stroke "green" stroke-width THICK {}
    connector id "ligacao-etapa-1-2" from "etapa-consulta" to "etapa-mapeamento" label "depois" {}
    connector id "ligacao-etapa-2-3" from "etapa-mapeamento" to "etapa-revisao" label "depois" {}
    connector id "ligacao-etapa-3-4" from "etapa-revisao" to "etapa-prototipo" label "se conforme" {}
    connector id "ligacao-etapa-4-5" from "etapa-prototipo" to "etapa-formacao" label "preparar uso" {}
    connector id "ligacao-etapa-5-6" from "etapa-formacao" to "etapa-piloto" label "iniciar limitado" {}
    connector id "ligacao-etapa-6-7" from "etapa-piloto" to "etapa-avaliacao" label "medir antes e depois" {}
    connector id "ligacao-etapa-7-8" from "etapa-avaliacao" to "etapa-escala" label "só com evidência e aprovação" {}
  ] id "estrategia-neda" name "Estratégia do projecto" layout GRID columns 3 background "white" {}
] title "NEDA — Viabilidade e piloto inicial no Sumbe" show-page-tabs false show-page-menu false {}..