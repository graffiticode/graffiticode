item [
  stimulus [
    title "Roman Aqueducts"
    paragraphs [
      "Long ago, Rome did not have enough fresh water."
      "Workers built long channels called aqueducts to bring water to the city."
      "Some aqueducts began at springs far away in the hills."
      "The channels tilted down a little, so the water flowed on its own."
      "Tall stone arches held the channel over low valleys."
      "By the time it reached Rome, the water had gone more than sixty miles."
      "In the city, people filled their jugs at open fountains."
      "Workers cleaned the channels often to keep the water fresh."
    ]
  ]
  parts [
    hottext [
      prompt "Roman aqueducts carried water to the city from far away. Click the sentence(s) from the passage that support this idea."
      within "stimulus"
      response-processing "match-correct"
      min-choices 3
      max-choices 3
      selections [
        [
          quote "Long ago, Rome did not have enough fresh water."
        ]
        [
          quote "Workers built long channels called aqueducts to bring water to the city."
          assess [
            correct
          ]
        ]
        [
          quote "Some aqueducts began at springs far away in the hills."
          assess [
            correct
          ]
        ]
        [
          quote "The channels tilted down a little, so the water flowed on its own."
        ]
        [
          quote "Tall stone arches held the channel over low valleys."
        ]
        [
          quote "By the time it reached Rome, the water had gone more than sixty miles."
          assess [
            correct
          ]
        ]
        [
          quote "In the city, people filled their jugs at open fountains."
        ]
        [
          quote "Workers cleaned the channels often to keep the water fresh."
        ]
      ] {}
    ]
  ] {}
]..