{
  "publishConfig": {
    "access": "public"
  },
  "name": "@graffiticode/l0179",
  "version": "0.1.0",
  "description": "L0179 — a Graffiticode dialect for interactive spreadsheets, inheriting @graffiticode/l0000",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./spec/*": "./spec/*"
  },
  "files": [
    "dist",
    "spec"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build-static": "node tools/build-static.js",
    "test": "vitest run",
    "lint": "eslint src tools"
  },
  "dependencies": {
    "@graffiticode/l0000": "^0.3.0",
    "decimal.js": "^10.5.0"
  },
  "devDependencies": {
    "@graffiticode/parser": "^1.6.1",
    "spec-md": "^3.1.0"
  }
}
