{
  "name": "@graffiticode/api-l0185",
  "private": true,
  "version": "0.1.0",
  "description": "L0185 language server — runs the L0185 core and serves /compile, /form, and public static assets",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "FIRESTORE_EMULATOR_HOST=\"127.0.0.1:8080\" AUTH_URL=\"http://127.0.0.1:4100\" tsx watch src/main.ts",
    "start": "node dist/main.js",
    "lint": "eslint src",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@graffiticode/l0185": "*",
    "cors": "^2.8.5",
    "errorhandler": "^1.5.1",
    "express": "^4.21.0",
    "ipaddr.js": "^2.5.0",
    "method-override": "^3.0.0",
    "morgan": "^1.10.0",
    "undici": "^7.30.0"
  },
  "devDependencies": {
    "@graffiticode/parser": "^1.7.0",
    "@types/cors": "^2.8.17",
    "@types/errorhandler": "^1.5.3",
    "@types/express": "^4.17.21",
    "@types/method-override": "^0.0.35",
    "@types/morgan": "^1.9.9",
    "ajv": "^8.20.0",
    "supertest": "^7.0.0",
    "vitest": "^5.0.1"
  }
}
