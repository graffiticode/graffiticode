{
  "name": "@graffiticode/l0184-monorepo",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "description": "L0184 \u2014 a Graffiticode dialect for charts (Apache ECharts)",
  "workspaces": [
    "packages/view"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@10.9.2",
  "scripts": {
    "build": "npm run -w packages/view build && npm run -w packages/view build:embed",
    "test": "node --test tools/docs.test.mjs && npm run -w packages/view test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "typecheck": "npm run -w packages/view typecheck",
    "publish": "npm -w packages/view publish --access=public",
    "gcp:logs": "gcloud run services logs read l0184r --project graffiticode --region us-central1",
    "view:fixtures": "node tools/view-fixtures.mjs",
    "rust:static": "node tools/assemble-static.mjs",
    "rust:build": "npm run rust:static && cargo build --release -p l0184r-server",
    "rust:dev": "AUTH_URL=\"http://127.0.0.1:4100\" PORT=50184 cargo run -p l0184r-server",
    "rust:test": "cargo test",
    "rust:lint": "cargo clippy --all-targets -- -D warnings"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@graffiticode/l0000": "^0.8.0",
    "@types/node": "^22.7.0",
    "ajv": "^8.17.1",
    "eslint": "^10.10.0",
    "globals": "^15.11.0",
    "prettier": "^3.3.3",
    "shx": "^0.4.0",
    "spec-md": "^3.1.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.10.0",
    "vitest": "^5.0.1"
  }
}
