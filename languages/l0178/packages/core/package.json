{
  "publishConfig": {
    "access": "public"
  },
  "name": "@graffiticode/l0178",
  "version": "0.1.0",
  "description": "L0178 — a Graffiticode dialect (hello/image/theme/print) inheriting @graffiticode/l0000",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./spec/*": "./spec/*"
  },
  "files": [
    "dist",
    "spec"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build-static": "node tools/build-static.js",
    "lint": "eslint src tools",
    "test": "vitest run"
  },
  "dependencies": {
    "@graffiticode/l0000": "^0.2.1"
  },
  "devDependencies": {
    "@graffiticode/parser": "^1.6.1",
    "spec-md": "^3.1.0"
  }
}
