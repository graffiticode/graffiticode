{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": false,
    "composite": true,
    "declaration": true,
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/.tsbuildinfo"
  },
  "include": [
    "src/**/*.js",
    "src/**/*.ts"
  ],
  "exclude": [
    "src/**/*.spec.js",
    "src/**/*.spec.ts"
  ],
  "references": [
    {
      "path": "../common/tsconfig.build.json"
    },
    {
      "path": "../auth/tsconfig.build.json"
    }
  ]
}
